    {"id":"write","owner":"News Writing Teams","mode":"draft-generation","status":"needs-model-or-rule-based-writer"},
    {"id":"edit","owner":"Editorial, Urdu, Legal, Ethics","mode":"multi-check-review","status":"scaffolded"},
